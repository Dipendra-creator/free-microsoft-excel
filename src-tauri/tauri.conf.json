{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sheets",
  "version": "0.1.0",
  "identifier": "com.internal.sheets",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sheets",
        "width": 1400,
        "height": 880,
        "minWidth": 760,
        "minHeight": 480,
        "center": true,
        "decorations": false,
        "backgroundColor": "#141414"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Lightweight spreadsheet",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["xlsx"],
        "name": "Excel Workbook",
        "description": "Excel Workbook",
        "role": "Editor"
      },
      {
        "ext": ["csv"],
        "name": "CSV File",
        "description": "Comma separated values",
        "role": "Editor"
      }
    ]
  }
}
